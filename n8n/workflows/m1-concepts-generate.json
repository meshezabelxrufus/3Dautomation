      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Validates the request from the web app. Model/effort/provider are configuration, not secrets.\nconst body = $input.first().json.body ?? {};\nconst errors = {};\nconst projectId = typeof body.project_id === 'string' ? body.project_id.trim() : '';\nif (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(projectId)) errors.project_id = 'project_id must be a UUID.';\nconst count = body.concept_count === undefined ? 3 : Number(body.concept_count);\nif (!Number.isInteger(count) || count < 2 || count > 5) errors.concept_count = 'concept_count must be an integer from 2 to 5.';\nconst cfg = body.config && typeof body.config === 'object' ? body.config : {};\nconst providerMode = cfg.provider_mode === 'mock' ? 'mock' : 'live';\nconst config = {\n  provider_mode: providerMode,\n  model: typeof cfg.model === 'string' && /^claude-[a-z0-9.-]+$/.test(cfg.model) ? cfg.model : 'claude-sonnet-5-5',\n  effort: ['low', 'medium', 'high', 'xhigh', 'max'].includes(cfg.effort) ? cfg.effort : 'high',\n  mock_scenario: providerMode === 'mock' && typeof cfg.mock_scenario === 'string' ? cfg.mock_scenario : 'ok',\n};\nreturn [{ json: { valid: Object.keys(errors).length === 0, errors, project_id: projectId, concept_count: count, config } }];"
      }
    },
