        "jsCode": "// The database rejected or could not store the concepts: fail the project cleanly.\nconst save = $('Evaluate response').last().json;\nconst err = $input.first().json;\nconst detail = String(err.message ?? err.error?.message ?? err.error?.description ?? 'database error').slice(0, 500);\nreturn [{ json: { action: 'fail', project_id: save.project_id, failure: { code: 'database_error', reason: 'The concepts could not be saved. Please try again.', detail }, meta: save.meta } }];"
