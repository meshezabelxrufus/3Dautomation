        "jsCode": "/* @include lib/concept-generation.cjs */\n\n// One decision per Claude call: save, retry (repair / backoff) or fail gracefully.\nconst { state, request } = $('Attempt').last().json;\nconst r = $input.first().json;\nlet result;\nif (r.transportError) result = { transportError: r.transportError };\nelse if (r.statusCode !== undefined) result = { statusCode: r.statusCode, body: r.body };\nelse result = { transportError: String(r.error?.message ?? r.message ?? r.error?.description ?? 'request failed') };\nreturn [{ json: evaluateAttempt(state, request, result) }];"
      }
