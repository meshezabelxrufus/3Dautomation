        "language": "javaScript",
        "jsCode": "/* @include lib/refinement.cjs */\n\n// Claude sees the current version itself, not just its description.\nconst d = $('Prepare response').first().json;\nconst img = $input.first().json;\nconst c = d.ctx;\nconst state = buildRefineState({\n  revisionId: c.revision_id, projectId: c.project_id, conceptId: c.concept_id,\n  revisionNumber: c.revision_number, baseRevisionNumber: c.base_revision_number, runNumber: c.run_number,\n  concept: c, currentPrompt: c.current_prompt, history: c.history, feedback: c.client_feedback,\n  image: img && img.data_base64 ? { mimeType: img.mime_type, data: img.data_base64 } : null,\n  config: d.request.config,\n});\nreturn [{ json: { state, request: buildRefineRequest(state), ctx: c, config: d.request.config } }];"
