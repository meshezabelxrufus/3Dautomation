        880,
        220
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const r = $input.first().json;\nconst req = $('Validate request').first().json;\nlet statusCode = 202, responseBody = { revision_id: req.revision_id, status: 'GENERATING', accepted: true }, started = true;\nif (!r.revision_id) { statusCode = 422; responseBody = { error: { code: 'revision_not_found', message: 'No such revision for this concept and project.' } }; started = false; }\nelse if (r.revision_status !== 'GENERATING') { statusCode = 409; responseBody = { error: { code: 'invalid_state', message: `The revision is already ${r.revision_status}.` } }; started = false; }\nelse if (!r.claimed) { statusCode = 409; responseBody = { error: { code: 'refinement_in_progress', message: 'This refinement is already being processed.' } }; started = false; }\nelse if (!r.base_asset_id) { statusCode = 409; responseBody = { error: { code: 'no_base_image', message: 'The concept has no image to refine yet.' } }; started = false; }\nreturn [{ json: { statusCode, body: responseBody, started, ctx: r, request: req } }];"
      }
