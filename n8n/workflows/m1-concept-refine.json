        "jsCode": "/* @include lib/image-generation.cjs */\n\n// The image model edits the current image with Claude's edit prompt (what changes + what stays).\nconst prev = $input.first().json;\nconst img = $('Fetch current image').last().json;\nconst state = buildImageState({ revisionId: prev.revision_id, projectId: prev.project_id, conceptNumber: prev.ctx.concept_number,\n  prompt: prev.interpretation.edit_prompt, config: { ...prev.config, mock_scenario: prev.config.image_mock_scenario },\n  referenceImage: true, skipSuffix: true });\nconst request = buildProviderRequest(state, { mimeType: img.mime_type, data: img.data_base64 });\nreturn [{ json: { state, request, interpretation: prev.interpretation, interpretation_meta: prev.meta } }];"
