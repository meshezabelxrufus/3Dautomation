    {
      "id": "a1a1e0c2-0007-4a3f-9d10-000000000005",
      "name": "Load refinement",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        660,
        240
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH claim AS (\n  -- Claim the run: a duplicate webhook for the same revision finds it claimed and stops (no double cost).\n  UPDATE revisions SET claimed_at = now()\n  WHERE id = $1::uuid AND status = 'GENERATING' AND (claimed_at IS NULL OR claimed_at < now() - interval '11 minutes')\n  RETURNING id\n)\nSELECT (SELECT count(*) FROM claim)::int AS claimed, r.id AS revision_id, r.status AS revision_status, r.client_feedback, r.revision_number, r.base_revision_id,\n       c.id AS concept_id, c.project_id, c.concept_number, c.title, c.description, c.creative_direction,\n       c.visual_characteristics, c.shape_language, c.key_features, c.materials,\n       COALESCE(b.image_asset_id, c.image_asset_id) AS base_asset_id,\n       COALESCE(b.interpreted_instruction->>'revised_prompt', c.generation_prompt) AS current_prompt,\n       COALESCE(b.revision_number, 0) AS base_revision_number,\n       (SELECT count(*)::int FROM project_events e WHERE e.project_id = c.project_id\n          AND e.event_type = 'REFINEMENT_STARTED' AND e.payload->>'revisionId' = r.id::text) AS run_number,\n       (WITH RECURSIVE chain AS (\n          SELECT x.id, x.base_revision_id, x.revision_number, x.client_feedback, x.interpreted_instruction\n          FROM revisions x WHERE x.id = r.base_revision_id\n          UNION ALL\n          SELECT y.id, y.base_revision_id, y.revision_number, y.client_feedback, y.interpreted_instruction\n          FROM revisions y JOIN chain ON y.id = chain.base_revision_id)\n        SELECT COALESCE(jsonb_agg(jsonb_build_object('revision', revision_number, 'feedback', client_feedback,\n                                  'summary', interpreted_instruction->>'summary') ORDER BY revision_number), '[]'::jsonb)\n        FROM chain) AS history\nFROM revisions r\nJOIN concepts c ON c.id = r.concept_id\nLEFT JOIN revisions b ON b.id = r.base_revision_id\nWHERE r.id = $1::uuid AND c.id = $2::uuid AND c.project_id = $3::uuid;",
        "options": {
          "queryReplacement": "={{ [ $json.revision_id, $json.concept_id, $json.project_id ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "name": "3D Studio — App DB"
        }
      },
      "onError": "continueErrorOutput",
      "alwaysOutputData": true
    },
