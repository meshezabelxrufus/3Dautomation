        "jsCode": "const r = $input.first().json;\nconst req = $('Validate request').first().json;\nconst answers = {\n  started: [202, { view_id: req.view_id, status: 'GENERATING', accepted: true }],\n  in_progress: [409, { error: { code: 'view_in_progress', message: 'This view is already being generated.' } }],\n  already_done: [409, { error: { code: 'view_already_done', message: 'This view already has its image.' } }],\n  stale: [409, { error: { code: 'stale_view', message: 'A newer version of this view exists.' } }],\n  no_prompts: [409, { error: { code: 'no_prompts', message: 'The view instructions are not ready.' } }],\n  not_found: [422, { error: { code: 'view_not_found', message: 'View not found.' } }],\n};\nconst [statusCode, responseBody] = answers[r.outcome] ?? [500, { error: { code: 'unexpected', message: 'Unexpected result.' } }];\nreturn [{ json: { statusCode, body: responseBody, started: r.outcome === 'started', claim: r, request: req } }];"
