      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// One image job per view, each its own execution of \"[3D Studio] M1 · View image — generate\",\n// so one failed view never affects the others.\nconst d = $('Prepare response').first().json;\nconst cfg = d.request.config;\nreturn d.claim.views.map((v) => ({ json: { view_id: v.view_id, view_type: v.view_type, body: { view_id: v.view_id, config: { provider_mode: cfg.provider_mode, image_model: cfg.image_model, image_mock_scenario: cfg.image_mock_scenario, image_provider: cfg.image_provider, pollinations_model: cfg.pollinations_model, pollinations_view_model: cfg.pollinations_view_model } } } }));"
