      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const fan = $('Fan out views').all();\nconst res = $input.all();\nconst undispatched = [];\nfan.forEach((f, i) => { if ((res[i]?.json ?? {}).statusCode !== 202) undispatched.push(f.json.view_id); });\nreturn [{ json: { project_id: $('Prepare response').first().json.request.project_id, view_ids: fan.map((f) => f.json.view_id), undispatched } }];"
