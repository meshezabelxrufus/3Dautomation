        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const r = $input.first().json;\nconst req = $('Validate request').first().json;\nconst views = Array.isArray(r.views) ? r.views : [];\nconst answers = {\n  started: [202, { project_id: req.project_id, final_design_id: req.final_design_id, view_types: views.map((v) => v.view_type), status: 'GENERATING_VIEWS', accepted: true }],\n  in_progress: [409, { error: { code: 'views_in_progress', message: 'That view is already being generated.' } }],\n  not_retryable: [409, { error: { code: 'not_retryable', message: 'Only failed views can be generated again while views are being generated.' } }],\n  nothing_to_do: [409, { error: { code: 'nothing_to_do', message: 'There are no views to generate.' } }],\n  invalid_state: [409, { error: { code: 'invalid_state', message: `Views can't be generated while the project is ${r.project_status}.` } }],\n  not_found: [422, { error: { code: 'design_not_found', message: 'No finalized design for this project.' } }],\n};\nconst [statusCode, responseBody] = answers[r.outcome] ?? [500, { error: { code: 'unexpected', message: 'Unexpected result.' } }];\nreturn [{ json: { statusCode, body: responseBody, started: r.outcome === 'started', claim: { ...r, views }, request: req } }];"
