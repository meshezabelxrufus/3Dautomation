      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Four views of the finalized design: first run, retry of failed views, or \"regenerate this view\".\nconst body = $input.first().json.body ?? {};\nconst errors = {};\nconst uuid = (v) => (typeof v === 'string' && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(v.trim()) ? v.trim() : null);\nconst projectId = uuid(body.project_id);\nconst designId = uuid(body.final_design_id);\nif (!projectId) errors.project_id = 'project_id must be a UUID.';\nif (!designId) errors.final_design_id = 'final_design_id must be a UUID.';\nconst allowed = ['FRONT', 'BACK', 'LEFT', 'RIGHT'];\nconst viewTypes = Array.isArray(body.view_types) ? [...new Set(body.view_types)] : [];\nif (viewTypes.some((t) => !allowed.includes(t))) errors.view_types = 'view_types must be FRONT, BACK, LEFT or RIGHT.';\nconst cfg = body.config && typeof body.config === 'object' ? body.config : {};\nconst providerMode = cfg.provider_mode === 'mock' ? 'mock' : 'live';\nconst config = {\n  provider_mode: providerMode,\n  model: typeof cfg.model === 'string' && /^claude-[a-z0-9.-]+$/.test(cfg.model) ? cfg.model : 'claude-sonnet-5-5',\n  effort: ['low', 'medium', 'high', 'xhigh', 'max'].includes(cfg.effort) ? cfg.effort : 'high',\n  image_model: typeof cfg.image_model === 'string' && /^gemini-[a-z0-9.-]+$/.test(cfg.image_model) ? cfg.image_model : 'gemini-3.1-flash-image',\n  mock_scenario: providerMode === 'mock' && typeof cfg.mock_scenario === 'string' ? cfg.mock_scenario : 'ok',\n  image_mock_scenario: providerMode === 'mock' && typeof cfg.image_mock_scenario === 'string' ? cfg.image_mock_scenario : 'ok',\n  image_provider: cfg.image_provider === 'pollinations' ? 'pollinations' : 'gemini',\n  pollinations_model: typeof cfg.pollinations_model === 'string' && /^[a-z0-9._-]+\\/[a-z0-9._-]+$/i.test(cfg.pollinations_model) ? cfg.pollinations_model : undefined,\n  // Views need a model that can move the camera around the reference object.\n  pollinations_view_model: typeof cfg.pollinations_view_model === 'string' && /^[a-z0-9._-]+\\/[a-z0-9._-]+$/i.test(cfg.pollinations_view_model) ? cfg.pollinations_view_model : 'openai/gpt-image-1-mini',\n};\nreturn [{ json: { valid: Object.keys(errors).length === 0, errors, project_id: projectId, final_design_id: designId, view_types: viewTypes, config } }];"
      }
    },
