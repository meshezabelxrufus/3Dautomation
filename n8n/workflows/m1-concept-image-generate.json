        "jsCode": "/* @include lib/image-generation.cjs */\n\nconst att = $('Image attempt').last().json;\nconst r = $input.first().json;\nlet result;\nif (r.transportError) result = { transportError: r.transportError };\nelse if (r.statusCode !== undefined) result = { statusCode: r.statusCode, body: r.body };\nelse result = { transportError: String(r.error?.message ?? r.message ?? r.error?.description ?? 'request failed') };\nconst out = evaluateImageAttempt(att.state, result);\nfor (const k of []) if (att[k] !== undefined && out[k] === undefined) out[k] = att[k];\nif (out.action === 'retry' && !out.request) out.request = att.request;\nreturn [{ json: out }];"
