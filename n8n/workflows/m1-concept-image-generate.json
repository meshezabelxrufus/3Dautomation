        "jsCode": "const r = $input.first().json;\nconst req = $('Validate request').first().json;\nconst answers = {\n  started: [202, { concept_id: req.concept_id, status: 'GENERATING', accepted: true }],\n  in_progress: [409, { error: { code: 'image_in_progress', message: 'An image is already being generated for this concept.' } }],\n  already_done: [409, { error: { code: 'image_already_done', message: `The concept already has its image (${r.concept_status}).` } }],\n  invalid_state: [409, { error: { code: 'invalid_state', message: `Images can't be generated while the project is ${r.project_status}.` } }],\n  not_found: [422, { error: { code: 'concept_not_found', message: 'Concept not found.' } }],\n};\nconst [statusCode, responseBody] = answers[r.outcome] ?? [500, { error: { code: 'unexpected', message: 'Unexpected result.' } }];\nreturn [{ json: { statusCode, body: responseBody, started: r.outcome === 'started', claim: r, request: req } }];"
