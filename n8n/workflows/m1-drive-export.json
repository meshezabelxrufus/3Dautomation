        "jsCode": "const r = $input.first().json;\nconst req = $('Validate request').first().json;\nconst answers = {\n  started: [202, { project_id: req.project_id, export_id: r.export_id, status: 'UPLOADING_TO_DRIVE', accepted: true }],\n  already_completed: [200, { project_id: req.project_id, status: 'COMPLETED', already_completed: true }],\n  in_progress: [409, { error: { code: 'export_in_progress', message: 'The Drive upload is already running.' } }],\n  invalid_state: [409, { error: { code: 'invalid_state', message: `The package can't be delivered while the project is ${r.project_status}.` } }],\n  not_found: [422, { error: { code: 'project_not_found', message: 'Project not found.' } }],\n};\nconst [statusCode, responseBody] = answers[r.outcome] ?? [500, { error: { code: 'unexpected', message: 'Unexpected result.' } }];\nreturn [{ json: { statusCode, body: responseBody, started: r.outcome === 'started', claim: r, request: req } }];"
