        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "/* @include lib/drive.cjs */\n\n// Records what Drive answered for the current item (and decides retries).\nconst act = $('Step').last().json;\nconst r = $input.first().json;\nlet result;\nif (r.result) result = r.result;\nelse if (r.statusCode !== undefined) result = { statusCode: r.statusCode, body: r.body };\nelse result = { transportError: String(r.error?.message ?? r.message ?? r.error?.description ?? 'request failed') };\nreturn [{ json: applyResult(act.state, act.item_key, result) }];"
      }
