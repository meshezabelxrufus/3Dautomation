        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Delivers the approved design package to Google Drive. Safe to call repeatedly (idempotent).\nconst body = $input.first().json.body ?? {};\nconst errors = {};\nconst projectId = typeof body.project_id === 'string' ? body.project_id.trim() : '';\nif (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(projectId)) errors.project_id = 'project_id must be a UUID.';\nconst cfg = body.config && typeof body.config === 'object' ? body.config : {};\nconst config = {\n  drive_mode: cfg.drive_mode === 'live' ? 'live' : 'test',\n  drive_parent_folder_id: typeof cfg.drive_parent_folder_id === 'string' && /^[\\w-]{10,}$/.test(cfg.drive_parent_folder_id) ? cfg.drive_parent_folder_id : 'root',\n};\nreturn [{ json: { valid: Object.keys(errors).length === 0, errors, project_id: projectId, config } }];"
      }
    },
