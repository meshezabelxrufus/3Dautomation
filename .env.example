# -----------------------------------------------------------------------------
# 3D Design Studio — environment template
#
# Create your local .env with:   sh scripts/init-env.sh   (or: pnpm env:init)
# That copies this file and replaces every __GENERATE__ with a random secret.
#
# NEVER commit .env. Only this template (placeholders, no real values) is tracked.
# AI provider keys (Anthropic, Gemini) and Google Drive OAuth do NOT go here:
# they are stored as n8n credentials (architecture §9.2).
# -----------------------------------------------------------------------------

# --- Compose ------------------------------------------------------------------
# "n8n" starts the project-owned n8n in this stack. Set to empty to use an external n8n.
COMPOSE_PROFILES=n8n

# Host ports (bound to 127.0.0.1). Chosen to avoid 3000/5432/5678 used by other local stacks.
WEB_HOST_PORT=3100
N8N_HOST_PORT=5680
POSTGRES_HOST_PORT=5434

GENERIC_TIMEZONE=UTC

# --- PostgreSQL ---------------------------------------------------------------
# Superuser (init scripts / admin only). Hex secrets keep connection URLs URL-safe.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__GENERATE__

# Web app database + role
APP_DB_NAME=app
APP_DB_USER=app_user
APP_DB_PASSWORD=__GENERATE__

# n8n database + role
N8N_DB_NAME=n8n
N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=__GENERATE__

# --- n8n ----------------------------------------------------------------------
# Encrypts every credential stored in n8n. BACK IT UP. Changing it on an existing
# instance makes stored credentials unreadable and n8n refuses to start.
N8N_ENCRYPTION_KEY=__GENERATE__
N8N_SECURE_COOKIE=false
N8N_PAYLOAD_SIZE_MAX=64
EXECUTIONS_DATA_MAX_AGE=336

# --- Web app ------------------------------------------------------------------
APP_BASE_URL=http://localhost:3100
# n8n base URL as seen from the web container:
#   project n8n (default):         http://n8n:5678
#   external/shared n8n on host:   http://host.docker.internal:5678
N8N_WEBHOOK_BASE_URL=http://n8n:5678

# --- n8n deploy tooling (developer machine / CI only; never passed to containers) ---
# API key: n8n editor -> Settings -> n8n API -> Create an API key.
# "local" = the project n8n from this stack. Add *_PRODUCTION for the VPS later.
N8N_DEPLOY_URL_LOCAL=http://localhost:5680
N8N_DEPLOY_API_KEY_LOCAL=
