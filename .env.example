# -----------------------------------------------------------------------------
# 3D Design Studio — environment template
#
# Create your local .env with:   sh scripts/init-env.sh   (or: pnpm env:init)
# That copies this file and replaces every __GENERATE__ with a random secret.
#
# NEVER commit .env. Only this template (placeholders, no real values) is tracked.
# AI provider keys (Anthropic, Gemini) and Google Drive OAuth do NOT go here:
# they are stored as n8n credentials (architecture §9.2).
# -----------------------------------------------------------------------------

# --- Compose ------------------------------------------------------------------
# "n8n" starts the project-owned n8n in this stack. Set to empty to use an external n8n.
# Add "drive-test" (COMPOSE_PROFILES=n8n,drive-test) for the local Google Drive test double (development only).
COMPOSE_PROFILES=n8n

# Host ports (bound to 127.0.0.1). Chosen to avoid 3000/5432/5678 used by other local stacks.
WEB_HOST_PORT=3100
N8N_HOST_PORT=5680
POSTGRES_HOST_PORT=5434

GENERIC_TIMEZONE=UTC

# --- PostgreSQL ---------------------------------------------------------------
# Superuser (init scripts / admin only). Hex secrets keep connection URLs URL-safe.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__GENERATE__

# Web app database + role
APP_DB_NAME=app
APP_DB_USER=app_user
APP_DB_PASSWORD=__GENERATE__

# n8n database + role
N8N_DB_NAME=n8n
N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=__GENERATE__

# --- n8n ----------------------------------------------------------------------
# Encrypts every credential stored in n8n. BACK IT UP. Changing it on an existing
# instance makes stored credentials unreadable and n8n refuses to start.
N8N_ENCRYPTION_KEY=__GENERATE__
N8N_SECURE_COOKIE=false
N8N_PAYLOAD_SIZE_MAX=64
EXECUTIONS_DATA_MAX_AGE=336

# --- Web app ------------------------------------------------------------------
APP_BASE_URL=http://localhost:3100
# n8n base URL as seen from the web container:
#   project n8n (default):         http://n8n:5678
#   external/shared n8n on host:   http://host.docker.internal:5678
N8N_WEBHOOK_BASE_URL=http://n8n:5678
# Shared secret the web app sends to n8n webhooks (header X-Webhook-Token). n8n checks it with the
# Header Auth credential "3D Studio — Inbound webhook token" (created by: pnpm n8n:credentials).
N8N_WEBHOOK_TOKEN=__GENERATE__
# Shared secret n8n sends back to the app (Authorization: Bearer …) when it stores or reads
# generated images. n8n credential "3D Studio — App callback token" (pnpm n8n:credentials).
N8N_CALLBACK_TOKEN=__GENERATE__

# --- Studio access ------------------------------------------------------------------------
# Password for the studio (sign-in page, HttpOnly signed session cookie). Leave empty only when the app is
# reachable from this machine alone (Compose binds it to 127.0.0.1). ALWAYS set it on a server.
STUDIO_ACCESS_PASSWORD=
# Signs the session cookie (32+ random characters).
STUDIO_SESSION_SECRET=__GENERATE__
# true when the app is served over HTTPS without a proxy that sets X-Forwarded-Proto.
SESSION_COOKIE_SECURE=false

# --- AI generation (non-secret settings sent to n8n with each job) -------------------------
# live = call Claude; mock = n8n uses its built-in deterministic test provider (no API cost).
AI_PROVIDER_MODE=live
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=high
# Nano Banana (Gemini image model) used for concept images and refinements.
IMAGE_MODEL=gemini-3.1-flash-image
# gemini (Nano Banana, default) | pollinations (for testing without a Gemini key; needs POLLINATIONS_API_KEY)
IMAGE_PROVIDER=gemini
# Pollinations model (generation + edits). Default black-forest-labs/flux.2-klein-4b.
POLLINATIONS_MODEL=
# Pollinations model for the four views: must rotate the camera around the reference. Default openai/gpt-image-1-mini
# (FLUX models keep the reference angle, so all four views would look the same).
POLLINATIONS_VIEW_MODEL=
# Only in mock mode: ok | slow | fail:<n> (concept n fails, a retry succeeds) | fail_always:<n> |
# blocked | api_error_then_ok | no_image_then_ok | api_down | auth_error | model_not_found
AI_IMAGE_MOCK_SCENARIO=
# Only in mock mode: ok | repairable | malformed_then_ok | too_similar_then_ok | truncated_then_ok |
# api_error_then_ok | always_malformed | api_down | transport_error | auth_error | refusal
AI_MOCK_SCENARIO=
# The Anthropic API key is NOT set here: enter it in n8n (credential "3D Studio — Anthropic"),
# or set ANTHROPIC_API_KEY below and run `pnpm n8n:credentials` (it is synced only when set).
ANTHROPIC_API_KEY=
# Same for Nano Banana: credential "3D Studio — Gemini", synced from here only when set.
GEMINI_API_KEY=
# For IMAGE_PROVIDER=pollinations: key from https://enter.pollinations.ai/keys. Synced to the credential
# "3D Studio — Pollinations" by `pnpm n8n:credentials` (only when set).
POLLINATIONS_API_KEY=

# --- Google Drive delivery ------------------------------------------------------------------
# live: Google Drive through the n8n credential "3D Studio — Google Drive" (connect it once in the n8n UI).
# test: the local Drive test double (docker compose profile "drive-test"); for development only.
DRIVE_MODE=live
# Optional: the Drive folder that should contain "3D PROJECTS" (default: My Drive root).
DRIVE_PARENT_FOLDER_ID=
# Google Cloud OAuth client (Web application) for the n8n credential; synced by `pnpm n8n:credentials` when set.
# Authorized redirect URI: <n8n URL>/rest/oauth2-credential/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- n8n deploy tooling (developer machine / CI only; never passed to containers) ---
# API key: n8n editor -> Settings -> n8n API -> Create an API key.
# "local" = the project n8n from this stack. Add *_PRODUCTION for the VPS later.
N8N_DEPLOY_URL_LOCAL=http://localhost:5680
N8N_DEPLOY_API_KEY_LOCAL=
# Host n8n uses to reach the app database (the Compose service name for the project n8n).
N8N_APP_DB_HOST=postgres
# The app as n8n reaches it, baked into the workflows at deploy time (image uploads/downloads).
# Compose: http://web:3000. Local dev server on the host: http://host.docker.internal:3101
N8N_APP_BASE_URL=http://web:3000
# n8n as it reaches itself (fan-out to child workflows). Default http://127.0.0.1:5678
N8N_SELF_URL=http://127.0.0.1:5678
# The Drive test double as n8n reaches it (only used when DRIVE_MODE=test). Default http://fake-drive:4010
N8N_FAKE_DRIVE_URL=http://fake-drive:4010
